# Independent kill switches for real execution. Both require LIVE_TRADING=true
# and LIVE_EXECUTION_IMPLEMENTED=True (hardcoded in app.py) to take effect.
LIVE_BUYS_ENABLED=false
LIVE_SELLS_ENABLED=false

# Lets score_trader() use a data-driven candidate quality (from
# get_trader_hit_stats) instead of the static TRADER_QUALITY dict, capped by
# TRADER_QUALITY_MAX_STEP once a trader has TRADER_QUALITY_MIN_SAMPLES results.
TRADER_DYNAMIC_QUALITY_ENABLED=false
TRADER_QUALITY_MIN_SAMPLES=30
TRADER_QUALITY_MAX_STEP=3

DB_PATH=/data/pumpcopilot.db
